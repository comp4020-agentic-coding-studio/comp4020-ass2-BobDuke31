---
import ContentLayout from "../../layouts/CourseContentLayout.astro";
import RunMap from "../../components/RunMap.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`Twelve weeks of losing, on purpose: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  {...siteConfig}
>
  <p>
    A course about failure gets to look like one. Below is the whole
    semester as a run: twelve nodes, each a week of {sessionLabels.plural.toLowerCase()},
    tagged by what kind of week it is. Opening one marks it cleared.
  </p>
  <RunMap />
</ContentLayout>
