---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "../layouts/CourseContentLayout.astro";
import LivesStrip from "../components/LivesStrip.astro";
import RevealGroup from "../components/RevealGroup.astro";
import RunMap from "../components/RunMap.astro";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  {...siteConfig}
>
  <div class="fs-panel fs-status-panel">
    <LivesStrip lives={3} spent={1} />

    <ul class="course-tags" aria-label="Course tags">
      {courseMeta.tags.map((tag) => <li class="fs-badge fs-badge--neutral">{tag}</li>)}
    </ul>
  </div>

  <h2>What you will do</h2>
  <p>
    Every week you take apart one way a game can make you lose, and put it
    back together with the reasoning showing. You will read failure design
    the way a critic reads a shot list: checkpoints, lives, permadeath and
    difficulty curves as deliberate choices with consequences, not as
    inconveniences the designer forgot to remove. By the end of semester you
    design and justify a fail state of your own.
  </p>

  <h2>Who it is for</h2>
  <p>
    Anyone who has rage-quit a game and then reopened it thirty seconds
    later, and wants the vocabulary for why. No engine or programming
    experience is assumed — the object of study is the feeling of losing,
    not the code that produces it — but you should already be a player, in
    something, sometimes badly.
  </p>

  <h2>The route so far</h2>
  <p>
    Twelve weeks, in order — the same run map that lives at {sessionLabels.plural}, shrunk to a
    strip. Open a week below and this fills in as you go.
  </p>
  <RunMap compact />

  <h2>Where to go next</h2>
  <RevealGroup>
    <CardGrid columns={2}>
      <Card title={sessionLabels.plural} href="/sessions/">
        <p>The run map: twelve weeks of failure design, in order.</p>
      </Card>
      <Card title="Assessment" href="/assessments/">
        <p>What is marked, what it is worth, and when it is due.</p>
      </Card>
      <Card title="People" href="/people/">
        <p>Who teaches the course and how to reach them.</p>
      </Card>
    </CardGrid>
  </RevealGroup>
</ContentLayout>

<style>
  .fs-status-panel {
    margin-block: 1.5rem 2rem;
  }

  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 1rem 0;
    padding: 0;
    list-style: none;
  }
</style>
