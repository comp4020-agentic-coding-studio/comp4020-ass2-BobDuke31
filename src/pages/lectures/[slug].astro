---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import Icon from "astro-theme-university/components/Icon.astro";
import ContentLayout from "../../layouts/CourseContentLayout.astro";
import CollectionPager from "../../components/CollectionPager.astro";
import { withBase } from "astro-theme-university/url";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const lectures = (await getPublishedCollection("lectures")).sort(
    (a, b) => a.data.week - b.data.week,
  );
  return lectures.map((lecture, index) => ({
    params: { slug: lecture.id },
    props: { lecture, prev: lectures[index - 1], next: lectures[index + 1] },
  }));
}

const { lecture, prev, next } = Astro.props;
const { Content } = await render(lecture);
const title = `Week ${lecture.data.week}: ${lecture.data.title}`;
const neighbourLabel = (entry: typeof lecture) => `Week ${entry.data.week}: ${entry.data.title}`;
---

<ContentLayout title={title} description={lecture.data.description} {...siteConfig}>
  <CollectionPager variant="back" backHref="/lectures/" backLabel="Lectures" />
  <div class="fs-lecture-meta">
    <p class="fs-lecture-date"><strong>{formatCourseDate(lecture.data.date)}</strong></p>
    <div class="fs-lecture-actions">
      {lecture.data.interactive && (
        <a href="#try-it" class="at-button at-button--small">
          <Icon name="flash" size="1em" /> Try the live demo
        </a>
      )}
      {lecture.data.slides && (
        <a href={withBase(lecture.data.slides)} class="at-button at-button--outline at-button--small">
          <Icon name="presentation" size="1em" /> Open the slides
        </a>
      )}
    </div>
  </div>
  <Content />
  <TeachingTeam teachers={lecture.data.teachers} />
  <RelatedContent entry={lecture} collections={graphCollections} />
  <CollectionPager
    variant="pager"
    prev={prev && { href: `/lectures/${prev.id}/`, label: neighbourLabel(prev) }}
    next={next && { href: `/lectures/${next.id}/`, label: neighbourLabel(next) }}
  />
</ContentLayout>

<style>
  .fs-lecture-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-block: 0 1.5rem;
  }

  .fs-lecture-date {
    margin: 0;
  }

  .fs-lecture-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
