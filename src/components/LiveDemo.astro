---
// One reusable "trigger, outcome, feedback" toy, reused with different
// content at three points in the course rather than three bespoke widgets.
// Each `mode` demonstrates that week's own thesis by making the reader
// cause a failure and watch the design respond to it, live.
//
// Checkpoint and juice modes show both sides of their comparison
// *simultaneously* on one click, rather than asking the reader to run a
// toggle/radio twice and remember what the other setting felt like — the
// interface carries the comparison, not the surrounding prose.
import Icon from "astro-theme-university/components/Icon.astro";

interface Props {
  mode: "checkpoint" | "assist" | "juice";
  heading?: string;
}

const { mode, heading } = Astro.props;

const defaultHeading: Record<Props["mode"], string> = {
  checkpoint: "Try it: two respawn policies, one hazard, at the same time",
  assist: "Try it: the same timing window, with and without assistance",
  juice: "Try it: two blocks, identical outcome, one button",
};

// Kept in sync with the matching constants in the checkpoint <script> below
// --- one is the Astro-side layout (where the track points sit), the other
// is the browser-side simulation (where the marker actually moves).
const checkpointAt = 45;
const hazardAt = 78;

const checkpointTracks = [
  { key: "punishing", label: "Punishing", sub: "back to the start" },
  { key: "generous", label: "Generous", sub: "back to the last flag" },
] as const;

const juiceColumns = [
  { key: "off", label: "No juice", juiced: false },
  { key: "on", label: "Juice on", juiced: true },
] as const;
---

<fs-live-demo data-mode={mode} class="fs-demo fs-panel">
  <h3>{heading ?? defaultHeading[mode]}</h3>

  {
    mode === "checkpoint" && (
      <>
        <div class="fs-demo-tracks">
          {checkpointTracks.map((track) => (
            <div class="fs-demo-stage" data-role="stage" data-track={track.key}>
              <p class="fs-demo-stage-heading">
                {track.label} <span class="fs-demo-stage-sub">— {track.sub}</span>
              </p>
              <p class="fs-demo-state fs-badge" data-role="state" aria-hidden="true">
                Ready
              </p>
              <div class="fs-demo-track" data-role="track">
                <div class="fs-demo-point fs-demo-point--start" style="left:0%">
                  <span class="fs-demo-point-dot" aria-hidden="true" />
                </div>
                <div
                  class="fs-demo-point fs-demo-point--checkpoint"
                  data-role="checkpoint-point"
                  style={`left:${checkpointAt}%`}
                >
                  <span class="fs-demo-point-dot" aria-hidden="true">
                    <Icon name="triangle-flag" size="0.75em" />
                  </span>
                </div>
                <div class="fs-demo-point fs-demo-point--hazard" style={`left:${hazardAt}%`}>
                  <span class="fs-demo-point-dot" aria-hidden="true">⚠</span>
                </div>
                <div class="fs-demo-point fs-demo-point--finish" style="left:100%">
                  <span class="fs-demo-point-dot" aria-hidden="true">
                    <Icon name="trophy" size="0.75em" />
                  </span>
                </div>
                <div class="fs-demo-marker" data-role="marker">
                  <span class="fs-demo-marker-label" aria-hidden="true">You</span>
                </div>
              </div>
              <div class="fs-demo-track-labels" aria-hidden="true">
                <span style="left:0%">Start</span>
                <span style={`left:${checkpointAt}%`}>Checkpoint</span>
                <span style={`left:${hazardAt}%`}>Hazard</span>
                <span style="left:100%">Finish</span>
              </div>
              <p class="fs-demo-loss" data-role="loss" aria-hidden="true" />
            </div>
          ))}
        </div>
        <div class="fs-demo-controls">
          <button type="button" class="at-button" data-action="attempt">
            <Icon name="play" class="fs-btn-icon" /> Run the hazard
          </button>
        </div>
      </>
    )
  }

  {
    mode === "assist" && (
      <>
        <div class="fs-demo-stage" data-role="stage">
          <div class="fs-demo-timing-track" data-role="track">
            <div class="fs-demo-target-zone" data-role="zone" />
            <div class="fs-demo-cursor" data-role="cursor" />
          </div>
        </div>
        <div class="fs-demo-controls">
          <label class="fs-demo-toggle">
            <input type="checkbox" data-role="assist-toggle" /> Assist Mode: widen the window and
            slow the timing
          </label>
          <button type="button" class="at-button" data-action="jump">
            <Icon name="arrow-up-circle" class="fs-btn-icon" /> Jump
          </button>
        </div>
      </>
    )
  }

  {
    mode === "juice" && (
      <>
        <div class="fs-demo-columns">
          {juiceColumns.map((column) => (
            <div class="fs-demo-stage" data-role="stage" data-juice={column.juiced ? "true" : "false"}>
              <p class="fs-demo-stage-heading">{column.label}</p>
              <p class="fs-demo-state fs-badge" data-role="state" aria-hidden="true">
                Ready
              </p>
              <div class="fs-demo-block-wrap">
                <div class="fs-demo-block" data-role="block">
                  ▮
                </div>
                {column.juiced && <div class="fs-demo-shards" data-role="shards" aria-hidden="true" />}
              </div>
              {column.juiced && (
                <>
                  <div class="fs-demo-impact-flash" data-role="impact-flash" aria-hidden="true" />
                  <p class="fs-demo-impact-pop" data-role="impact-pop" aria-hidden="true" />
                </>
              )}
              <div class="fs-demo-meter">
                <span class="fs-demo-meter-label">Felt impact</span>
                <div class="fs-demo-meter-track">
                  <div class="fs-demo-meter-fill" data-role="meter-fill" />
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="fs-demo-controls">
          <button type="button" class="at-button" data-action="break">
            <Icon name="hammer" class="fs-btn-icon" /> Break both blocks
          </button>
        </div>
      </>
    )
  }

  <p class="fs-demo-status" data-role="status" aria-live="polite">
    {
      mode === "checkpoint" &&
        "Press Run the hazard — both policies hit the same hazard at the same instant, and only the respawn differs."
    }
    {mode === "assist" && "Press Jump when the cursor is inside the zone."}
    {
      mode === "juice" &&
        "Press Break both blocks — same outcome on each, watch how differently it registers."
    }
  </p>
  <p class="fs-demo-stats" data-role="stats" aria-live="off"></p>
  {
    mode !== "juice" && (
      <div
        class="fs-demo-history"
        data-role="history"
        aria-hidden="true"
        title="Recent attempts, most recent last"
      />
    )
  }
</fs-live-demo>

<style>
  .fs-demo {
    display: block;
    margin: 1.75rem 0;
  }

  .fs-demo h3 {
    margin-top: 0;
  }

  .fs-btn-icon {
    vertical-align: -0.15em;
    margin-inline-end: 0.35em;
  }

  .fs-demo-tracks {
    display: grid;
    gap: 1.25rem;
  }

  .fs-demo-columns {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr 1fr;
  }

  @media (max-width: 32rem) {
    .fs-demo-columns {
      grid-template-columns: 1fr;
    }
  }

  .fs-demo-tracks .fs-demo-stage + .fs-demo-stage,
  .fs-demo-columns .fs-demo-stage {
    border-top: 1px solid color-mix(in srgb, var(--at-tertiary) 25%, transparent);
    padding-top: 1.1rem;
  }

  .fs-demo-columns .fs-demo-stage {
    border-top: none;
    border-inline-start: 1px solid color-mix(in srgb, var(--at-tertiary) 25%, transparent);
    padding-inline-start: 1.1rem;
  }

  @media (max-width: 32rem) {
    .fs-demo-columns .fs-demo-stage {
      border-inline-start: none;
      border-top: 1px solid color-mix(in srgb, var(--at-tertiary) 25%, transparent);
      padding-inline-start: 0;
      padding-top: 1.1rem;
    }

    .fs-demo-columns .fs-demo-stage:first-child {
      border-top: none;
      padding-top: 0;
    }
  }

  .fs-demo-stage-heading {
    margin: 0 0 0.5rem;
    font-weight: 700;
  }

  .fs-demo-stage-sub {
    font-weight: 400;
    color: var(--at-text-secondary);
  }

  .fs-demo-stage {
    position: relative;
    padding-top: 1.5rem;
  }

  .fs-demo-state {
    position: absolute;
    top: -0.5rem;
    inset-inline-end: 0;
    font-size: 0.68rem;
  }

  .fs-demo-state.fs-badge--danger {
    color: var(--fs-danger);
    background: color-mix(in srgb, var(--fs-danger) 18%, transparent);
  }

  .fs-demo-track,
  .fs-demo-timing-track {
    position: relative;
    height: 2.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--at-tertiary) 20%, transparent);
    overflow: visible;
  }

  .fs-demo-track-labels {
    position: relative;
    height: 1.1rem;
    margin-top: 0.4rem;
  }

  .fs-demo-track-labels span {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font-size: 0.65rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--at-text-secondary);
    white-space: nowrap;
  }

  .fs-demo-loss {
    min-height: 1.3em;
    margin: 0.4rem 0 0;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--fs-danger);
  }

  .fs-demo-point {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
  }

  .fs-demo-point-dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 2px solid var(--fs-map-line, color-mix(in srgb, var(--at-tertiary) 40%, transparent));
    background: var(--at-bg);
    font-size: 0.85rem;
    color: var(--at-text-secondary);
  }

  .fs-demo-point--hazard .fs-demo-point-dot {
    border-color: var(--fs-danger);
    color: var(--fs-danger);
  }

  .fs-demo-point--finish .fs-demo-point-dot {
    border-color: var(--at-primary);
    color: var(--at-primary);
  }

  .fs-demo-point--checkpoint.fs-demo-point--passed .fs-demo-point-dot {
    border-color: var(--fs-success);
    color: var(--fs-success);
    background: color-mix(in srgb, var(--fs-success) 22%, var(--at-bg));
  }

  .fs-demo-marker {
    position: absolute;
    top: 50%;
    left: 0;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--at-primary);
    transform: translate(-50%, -50%);
    transition-property: left;
    transition-timing-function: var(--fs-ease, ease);
    transition-duration: 300ms;
    z-index: 2;
    box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--at-primary) 25%, transparent);
  }

  .fs-demo-marker--snap {
    transition-duration: 0ms !important;
  }

  .fs-demo-marker--hit {
    background: var(--fs-danger);
    box-shadow: 0 0 0 0.3rem color-mix(in srgb, var(--fs-danger) 40%, transparent);
  }

  .fs-demo-marker--cleared {
    background: var(--fs-success);
    box-shadow: 0 0 0 0.3rem color-mix(in srgb, var(--fs-success) 40%, transparent);
  }

  .fs-demo-marker-label {
    position: absolute;
    top: -1.3rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--at-text-secondary);
    white-space: nowrap;
  }

  .fs-demo-cursor {
    position: absolute;
    top: 50%;
    left: 0;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--at-primary);
    transform: translate(-50%, -50%);
    animation: fs-demo-sweep 1.1s linear infinite alternate;
  }

  fs-live-demo[data-assist="true"] .fs-demo-cursor {
    animation-duration: 2.4s;
  }

  @keyframes fs-demo-sweep {
    from {
      left: 2%;
    }
    to {
      left: 98%;
    }
  }

  .fs-demo-target-zone {
    position: absolute;
    top: 0;
    left: 55%;
    width: 12%;
    height: 100%;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fs-success) 30%, transparent);
    transition: width var(--fs-medium, 320ms) var(--fs-ease, ease);
  }

  fs-live-demo[data-assist="true"] .fs-demo-target-zone {
    width: 32%;
    left: 42%;
  }

  .fs-demo-block-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4rem;
  }

  .fs-demo-block {
    display: inline-block;
    font-size: 2.5rem;
    line-height: 1;
    color: var(--at-primary);
    transition: opacity var(--fs-fast, 120ms) var(--fs-ease, ease);
  }

  .fs-demo-shards {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .fs-demo-shard {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--at-primary);
    transform: translate(-50%, -50%) rotate(var(--fs-shard-angle)) translateX(0);
    opacity: 0;
  }

  .fs-demo-shards--active .fs-demo-shard {
    animation: fs-shard-fly 550ms ease-out forwards;
  }

  @keyframes fs-shard-fly {
    0% {
      opacity: 1;
      transform: translate(-50%, -50%) rotate(var(--fs-shard-angle)) translateX(0);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) rotate(var(--fs-shard-angle)) translateX(2.6rem);
    }
  }

  .fs-demo-impact-flash {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: var(--at-border-radius);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--at-primary) 55%, transparent),
      transparent 70%
    );
    opacity: 0;
    pointer-events: none;
  }

  .fs-demo-impact-flash--active {
    animation: fs-impact-flash 400ms ease-out;
  }

  @keyframes fs-impact-flash {
    0% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
    }
  }

  .fs-demo-impact-pop {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 3;
    margin: 0;
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    color: var(--at-primary);
    opacity: 0;
    transform: translateX(-50%) scale(0.6);
  }

  .fs-demo-impact-pop--active {
    animation: fs-impact-pop 650ms cubic-bezier(0.2, 1.6, 0.4, 1);
  }

  @keyframes fs-impact-pop {
    0% {
      opacity: 0;
      transform: translateX(-50%) scale(0.4) translateY(0.5rem);
    }
    30% {
      opacity: 1;
      transform: translateX(-50%) scale(1.15) translateY(-0.3rem);
    }
    70% {
      opacity: 1;
      transform: translateX(-50%) scale(1) translateY(-0.3rem);
    }
    100% {
      opacity: 0;
      transform: translateX(-50%) scale(1) translateY(-0.6rem);
    }
  }

  .fs-demo-meter {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .fs-demo-meter-label {
    flex: none;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--at-text-secondary);
  }

  .fs-demo-meter-track {
    flex: 1;
    height: 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--at-tertiary) 20%, transparent);
    overflow: hidden;
  }

  .fs-demo-meter-fill {
    height: 100%;
    width: 0%;
    border-radius: 999px;
    background: var(--at-primary);
    transition-property: width;
    transition-timing-function: var(--fs-ease, ease);
    transition-duration: 150ms;
  }

  .fs-demo-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-block: 1rem;
  }

  .fs-demo-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .fs-demo-status {
    min-height: 1.4em;
    font-weight: 600;
  }

  .fs-demo-stats {
    color: var(--at-text-secondary);
    font-size: 0.9rem;
  }

  .fs-demo-history {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.5rem;
    min-height: 0.6rem;
  }

  .fs-history-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--fs-spent);
    flex: none;
  }

  .fs-history-dot--hit {
    background: var(--fs-success);
  }

  .fs-history-dot--miss {
    background: var(--fs-danger);
  }

  @media (prefers-reduced-motion: reduce) {
    .fs-demo-cursor {
      animation: none;
      left: 61%;
    }

    .fs-demo-marker {
      transition: none;
    }

    .fs-demo-shards--active .fs-demo-shard,
    .fs-demo-impact-flash--active,
    .fs-demo-impact-pop--active {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  import "../styles/failstate.css";

  class LiveDemo extends HTMLElement {
    attempts = 0;
    successes = 0;

    connectedCallback() {
      const mode = this.dataset.mode;
      if (mode === "checkpoint") this.setupCheckpoint();
      if (mode === "assist") this.setupAssist();
      if (mode === "juice") this.setupJuice();
    }

    status(text: string) {
      const el = this.querySelector<HTMLElement>('[data-role="status"]');
      if (el) el.textContent = text;
    }

    stats(text: string) {
      const el = this.querySelector<HTMLElement>('[data-role="stats"]');
      if (el) el.textContent = text;
    }

    // A row of dots is a faster read of "am I improving?" than the running
    // count in the stats line alone --- decorative and capped at ten, since
    // the accessible record of what happened stays in that aria-live text.
    pushHistory(kind: "hit" | "miss") {
      const history = this.querySelector<HTMLElement>('[data-role="history"]');
      if (!history) return;
      const dot = document.createElement("span");
      dot.className = `fs-history-dot fs-history-dot--${kind}`;
      history.appendChild(dot);
      while (history.children.length > 10) history.firstElementChild?.remove();
    }

    // A death and a success shouldn't flash the same colour --- "bad" reaches
    // for the danger ring, "good" (unused here today, kept for future modes)
    // for the success one. Applies to every `[data-role="stage"]` in this
    // demo at once, so a multi-stage mode (checkpoint's two tracks) flashes
    // together rather than just the first one found.
    flash(kind: "bad" | "good" = "bad") {
      const stages = this.querySelectorAll<HTMLElement>('[data-role="stage"]');
      stages.forEach((stage) => {
        stage.classList.remove("fs-shake", "fs-flash", "fs-flash--danger");
        // Force reflow so the animation can restart on repeated failures.
        void stage.offsetWidth;
        stage.classList.add("fs-shake", kind === "bad" ? "fs-flash--danger" : "fs-flash");
      });
    }

    // Every state change gets its own word in the corner, not just a colour
    // shift --- "Ready" / "Running…" / "Hit!" / "Cleared!" reads on its own,
    // decorative alongside the aria-live status line that carries the same
    // information for anyone not looking at the stage.
    setState(el: HTMLElement | null, label: string, tone: "default" | "danger" = "default") {
      if (!el) return;
      el.textContent = label;
      el.classList.toggle("fs-badge--danger", tone === "danger");
      el.classList.remove("fs-pop");
      void el.offsetWidth;
      el.classList.add("fs-pop");
    }

    // Both respawn policies face the exact same hazard at the exact same
    // instant --- one shared random roll drives both tracks, so the only
    // thing that can differ between them is where each one wakes back up.
    setupCheckpoint() {
      const hazardAt = 78;
      const checkpointAt = 45;
      const msPerPercent = 9;
      const button = this.querySelector<HTMLButtonElement>('[data-action="attempt"]');
      let attempts = 0;
      let deaths = 0;

      const trackConfig = [
        { key: "punishing", label: "Punishing", respawnAt: 0 },
        { key: "generous", label: "Generous", respawnAt: checkpointAt },
      ];

      const tracks = trackConfig.map((config) => {
        const stage = this.querySelector<HTMLElement>(`[data-track="${config.key}"]`);
        return {
          ...config,
          marker: stage?.querySelector<HTMLElement>('[data-role="marker"]') ?? null,
          state: stage?.querySelector<HTMLElement>('[data-role="state"]') ?? null,
          checkpointPoint: stage?.querySelector<HTMLElement>('[data-role="checkpoint-point"]') ?? null,
          lossEl: stage?.querySelector<HTMLElement>('[data-role="loss"]') ?? null,
          position: 0,
          totalLost: 0,
        };
      });

      const moveTo = (track: (typeof tracks)[number], target: number, instant = false) => {
        if (!track.marker) return 0;
        const distance = Math.abs(target - track.position);
        const duration = instant ? 0 : Math.max(150, distance * msPerPercent);
        track.marker.classList.toggle("fs-demo-marker--snap", instant);
        track.marker.style.left = `${target}%`;
        track.position = target;
        return duration;
      };

      tracks.forEach((track) => moveTo(track, 0, true));

      button?.addEventListener("click", () => {
        if (!button || button.disabled) return;
        button.disabled = true;
        tracks.forEach((track) => {
          track.marker?.classList.remove("fs-demo-marker--hit", "fs-demo-marker--cleared");
          track.checkpointPoint?.classList.add("fs-demo-point--passed");
          this.setState(track.state, "Running…");
        });
        this.status("Running toward the hazard…");
        const runMs = Math.max(...tracks.map((track) => moveTo(track, hazardAt)));

        window.setTimeout(() => {
          const died = Math.random() < 0.6;
          attempts += 1;
          this.pushHistory(died ? "miss" : "hit");

          if (died) {
            deaths += 1;
            tracks.forEach((track) => track.marker?.classList.add("fs-demo-marker--hit"));
            this.flash("bad");
            tracks.forEach((track) => this.setState(track.state, "Hit!", "danger"));

            const losses = tracks.map((track) => {
              const lost = Math.round(hazardAt - track.respawnAt);
              track.totalLost += lost;
              if (track.lossEl) track.lossEl.textContent = `Lost ${lost}% of the run`;
              return `${track.label} lost ${lost}%`;
            });
            this.status(`Hit the hazard. ${losses.join("; ")}.`);

            window.setTimeout(() => {
              const respawnMs = Math.max(...tracks.map((track) => moveTo(track, track.respawnAt)));
              window.setTimeout(() => {
                tracks.forEach((track) => {
                  track.marker?.classList.remove("fs-demo-marker--hit");
                  this.setState(track.state, "Ready");
                });
                this.status("Ready — press Run the hazard to go again.");
                button.disabled = false;
              }, respawnMs + 100);
            }, 500);
          } else {
            tracks.forEach((track) => {
              track.marker?.classList.add("fs-demo-marker--cleared");
              if (track.lossEl) track.lossEl.textContent = "";
            });
            tracks.forEach((track) => this.setState(track.state, "Cleared!"));
            this.status("Cleared the run — no death, so the respawn policy never came into play.");
            window.setTimeout(() => {
              const resetMs = Math.max(...tracks.map((track) => moveTo(track, 0)));
              window.setTimeout(() => {
                tracks.forEach((track) => {
                  track.marker?.classList.remove("fs-demo-marker--cleared");
                  this.setState(track.state, "Ready");
                });
                this.status("Ready — press Run the hazard to go again.");
                button.disabled = false;
              }, resetMs + 100);
            }, 700);
          }

          const totals = tracks.map((track) => `${track.label} total lost: ${track.totalLost}%`);
          this.stats(
            `${attempts} attempt${attempts === 1 ? "" : "s"} · ${deaths} death${deaths === 1 ? "" : "s"} · ${totals.join(" · ")}`,
          );
        }, runMs + 80);
      });
    }

    setupAssist() {
      const toggle = this.querySelector<HTMLInputElement>('[data-role="assist-toggle"]');
      const track = this.querySelector<HTMLElement>('[data-role="track"]');
      const cursor = this.querySelector<HTMLElement>('[data-role="cursor"]');
      const zone = this.querySelector<HTMLElement>('[data-role="zone"]');
      const button = this.querySelector<HTMLButtonElement>('[data-action="jump"]');

      toggle?.addEventListener("change", () => {
        this.toggleAttribute("data-assist", toggle.checked);
        this.dataset.assist = toggle.checked ? "true" : "false";
      });

      button?.addEventListener("click", () => {
        if (!track || !cursor || !zone) return;
        const trackBox = track.getBoundingClientRect();
        const cursorBox = cursor.getBoundingClientRect();
        const zoneBox = zone.getBoundingClientRect();
        const cursorCentre = cursorBox.left + cursorBox.width / 2;
        const hit = cursorCentre >= zoneBox.left && cursorCentre <= zoneBox.right;
        void trackBox;
        this.attempts += 1;
        this.pushHistory(hit ? "hit" : "miss");
        if (hit) {
          this.successes += 1;
          this.status("Clean hit.");
          const stage = this.querySelector<HTMLElement>('[data-role="stage"]');
          stage?.classList.add("fs-pulse");
          window.setTimeout(() => stage?.classList.remove("fs-pulse"), 400);
        } else {
          this.status("Missed — try again.");
          this.flash("bad");
        }
        const rate = Math.round((this.successes / this.attempts) * 100);
        this.stats(`${this.successes}/${this.attempts} hits (${rate}%)`);
      });
    }

    // Both blocks break on the same click --- the outcome (block gone) is
    // identical either way, so the only thing left to compare is how each
    // column announces it, side by side, in the same instant.
    setupJuice() {
      const button = this.querySelector<HTMLButtonElement>('[data-action="break"]');
      let breaks = 0;

      const columns = Array.from(this.querySelectorAll<HTMLElement>('[data-role="stage"]')).map(
        (stage) => ({
          stage,
          juiced: stage.dataset.juice === "true",
          state: stage.querySelector<HTMLElement>('[data-role="state"]'),
          block: stage.querySelector<HTMLElement>('[data-role="block"]'),
          shards: stage.querySelector<HTMLElement>('[data-role="shards"]'),
          impactFlash: stage.querySelector<HTMLElement>('[data-role="impact-flash"]'),
          impactPop: stage.querySelector<HTMLElement>('[data-role="impact-pop"]'),
          meterFill: stage.querySelector<HTMLElement>('[data-role="meter-fill"]'),
        }),
      );

      const spawnShards = (shards: HTMLElement) => {
        shards.innerHTML = "";
        for (let i = 0; i < 8; i += 1) {
          const shard = document.createElement("span");
          shard.className = "fs-demo-shard";
          const angle = (360 / 8) * i + (Math.random() * 16 - 8);
          shard.style.setProperty("--fs-shard-angle", `${angle}deg`);
          shards.appendChild(shard);
        }
        shards.classList.remove("fs-demo-shards--active");
        void shards.offsetWidth;
        shards.classList.add("fs-demo-shards--active");
      };

      const setMeter = (meterFill: HTMLElement | null, pct: number, snap: boolean) => {
        if (!meterFill) return;
        meterFill.style.transitionDuration = snap ? "80ms" : "600ms";
        meterFill.style.width = `${pct}%`;
      };

      button?.addEventListener("click", () => {
        if (button.disabled) return;
        button.disabled = true;
        breaks += 1;

        // A brief freeze before the burst is what makes the juiced column
        // read as an impact rather than a glitch --- the "hit-stop" every
        // juiced hit in a real game leans on. Both columns wait for it so
        // they still resolve on the same tick.
        window.setTimeout(() => {
          columns.forEach((column) => {
            if (!column.block) return;
            column.block.style.opacity = "0";

            if (column.juiced) {
              if (column.shards) spawnShards(column.shards);
              column.stage.classList.remove("fs-shake");
              void column.stage.offsetWidth;
              column.stage.classList.add("fs-shake");
              if (column.impactFlash) {
                column.impactFlash.classList.remove("fs-demo-impact-flash--active");
                void column.impactFlash.offsetWidth;
                column.impactFlash.classList.add("fs-demo-impact-flash--active");
              }
              if (column.impactPop) {
                column.impactPop.textContent = "IMPACT!";
                column.impactPop.classList.remove("fs-demo-impact-pop--active");
                void column.impactPop.offsetWidth;
                column.impactPop.classList.add("fs-demo-impact-pop--active");
              }
              this.setState(column.state, "Impact!", "danger");
              setMeter(column.meterFill, 100, true);
              window.setTimeout(() => setMeter(column.meterFill, 0, false), 450);
            } else {
              this.setState(column.state, "Gone.");
              setMeter(column.meterFill, 4, true);
              window.setTimeout(() => setMeter(column.meterFill, 0, false), 300);
            }
          });

          this.status(
            `Break #${breaks}: the outcome is identical on both blocks — only the feedback differed.`,
          );
          this.stats(`${breaks} break${breaks === 1 ? "" : "s"} so far.`);

          window.setTimeout(() => {
            columns.forEach((column) => {
              if (column.block) column.block.style.opacity = "1";
              this.setState(column.state, "Ready");
            });
            button.disabled = false;
          }, 500);
        }, 90);
      });
    }
  }

  if (!customElements.get("fs-live-demo")) {
    customElements.define("fs-live-demo", LiveDemo);
  }
</script>
