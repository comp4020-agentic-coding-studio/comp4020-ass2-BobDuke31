---
// One reusable "trigger, outcome, feedback" toy, reused with different
// content at three points in the course rather than three bespoke widgets.
// Each `mode` demonstrates that week's own thesis by making the reader
// cause a failure and watch the design respond to it, live.
import Icon from "astro-theme-university/components/Icon.astro";

interface Props {
  mode: "checkpoint" | "assist" | "juice";
  heading?: string;
}

const { mode, heading } = Astro.props;

const defaultHeading: Record<Props["mode"], string> = {
  checkpoint: "Try it: two respawn policies, one hazard",
  assist: "Try it: the same timing window, with and without assistance",
  juice: "Try it: identical outcome, two different feedback treatments",
};

// Kept in sync with the matching constants in the checkpoint <script> below
// --- one is the Astro-side layout (where the track points sit), the other
// is the browser-side simulation (where the marker actually moves).
const checkpointAt = 45;
const hazardAt = 78;
---

<fs-live-demo data-mode={mode} class="fs-demo fs-panel">
  <h3>{heading ?? defaultHeading[mode]}</h3>

  {
    mode === "checkpoint" && (
      <>
        <div class="fs-demo-stage" data-role="stage">
          <p class="fs-demo-state fs-badge" data-role="state" aria-hidden="true">
            Ready
          </p>
          <div class="fs-demo-track" data-role="track">
            <div class="fs-demo-point fs-demo-point--start" style="left:0%">
              <span class="fs-demo-point-dot" aria-hidden="true" />
            </div>
            <div
              class="fs-demo-point fs-demo-point--checkpoint"
              data-role="checkpoint-point"
              style={`left:${checkpointAt}%`}
            >
              <span class="fs-demo-point-dot" aria-hidden="true">
                <Icon name="triangle-flag" size="0.75em" />
              </span>
            </div>
            <div class="fs-demo-point fs-demo-point--hazard" style={`left:${hazardAt}%`}>
              <span class="fs-demo-point-dot" aria-hidden="true">⚠</span>
            </div>
            <div class="fs-demo-point fs-demo-point--finish" style="left:100%">
              <span class="fs-demo-point-dot" aria-hidden="true">
                <Icon name="trophy" size="0.75em" />
              </span>
            </div>
            <div class="fs-demo-marker" data-role="marker">
              <span class="fs-demo-marker-label" aria-hidden="true">You</span>
            </div>
          </div>
          <div class="fs-demo-track-labels" aria-hidden="true">
            <span style="left:0%">Start</span>
            <span style={`left:${checkpointAt}%`}>Checkpoint</span>
            <span style={`left:${hazardAt}%`}>Hazard</span>
            <span style="left:100%">Finish</span>
          </div>
        </div>
        <div class="fs-demo-controls">
          <fieldset>
            <legend>Respawn policy</legend>
            <label>
              <input type="radio" name={`policy-${mode}`} value="start" checked /> Punishing —
              back to the start
            </label>
            <label>
              <input type="radio" name={`policy-${mode}`} value="checkpoint" /> Generous — back
              to the last flag
            </label>
          </fieldset>
          <button type="button" data-action="attempt">
            <Icon name="play" class="fs-btn-icon" /> Attempt the run
          </button>
        </div>
      </>
    )
  }

  {
    mode === "assist" && (
      <>
        <div class="fs-demo-stage" data-role="stage">
          <div class="fs-demo-timing-track" data-role="track">
            <div class="fs-demo-target-zone" data-role="zone" />
            <div class="fs-demo-cursor" data-role="cursor" />
          </div>
        </div>
        <div class="fs-demo-controls">
          <label class="fs-demo-toggle">
            <input type="checkbox" data-role="assist-toggle" /> Assist Mode: widen the window and
            slow the timing
          </label>
          <button type="button" data-action="jump">
            <Icon name="arrow-up-circle" class="fs-btn-icon" /> Jump
          </button>
        </div>
      </>
    )
  }

  {
    mode === "juice" && (
      <>
        <div class="fs-demo-stage" data-role="stage">
          <p class="fs-demo-state fs-badge" data-role="state" aria-hidden="true">
            Ready
          </p>
          <div class="fs-demo-block-wrap">
            <div class="fs-demo-block" data-role="block">
              ▮
            </div>
            <div class="fs-demo-shards" data-role="shards" aria-hidden="true" />
          </div>
          <div class="fs-demo-impact-flash" data-role="impact-flash" aria-hidden="true" />
          <p class="fs-demo-impact-pop" data-role="impact-pop" aria-hidden="true" />
        </div>
        <div class="fs-demo-controls">
          <label class="fs-demo-toggle">
            <input type="checkbox" data-role="juice-toggle" checked /> Juice on: shake, flash and
            pulse feedback
          </label>
          <button type="button" data-action="break">
            <Icon name="hammer" class="fs-btn-icon" /> Break the block
          </button>
        </div>
        <div class="fs-demo-meter">
          <span class="fs-demo-meter-label">Felt impact</span>
          <div class="fs-demo-meter-track">
            <div class="fs-demo-meter-fill" data-role="meter-fill" />
          </div>
        </div>
      </>
    )
  }

  <p class="fs-demo-status" data-role="status" aria-live="polite">
    {
      mode === "checkpoint" &&
        "Choose a respawn policy, then attempt the run and watch what a death costs you."
    }
    {mode === "assist" && "Press Jump when the cursor is inside the zone."}
    {
      mode === "juice" &&
        "Same block, same outcome either way — press Break and watch how differently it registers."
    }
  </p>
  <p class="fs-demo-stats" data-role="stats" aria-live="off"></p>
  {
    mode !== "juice" && (
      <div
        class="fs-demo-history"
        data-role="history"
        aria-hidden="true"
        title="Recent attempts, most recent last"
      />
    )
  }
</fs-live-demo>

<style>
  .fs-demo {
    display: block;
    margin: 1.75rem 0;
  }

  .fs-demo h3 {
    margin-top: 0;
  }

  .fs-btn-icon {
    vertical-align: -0.15em;
    margin-inline-end: 0.35em;
  }

  .fs-demo-stage {
    position: relative;
    padding: 1.5rem 0 0.25rem;
  }

  .fs-demo-state {
    position: absolute;
    top: -0.5rem;
    inset-inline-end: 0;
    font-size: 0.68rem;
  }

  .fs-demo-state.fs-badge--danger {
    color: var(--fs-danger);
    background: color-mix(in srgb, var(--fs-danger) 18%, transparent);
  }

  .fs-demo-track,
  .fs-demo-timing-track {
    position: relative;
    height: 2.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--at-tertiary) 20%, transparent);
    overflow: visible;
  }

  .fs-demo-track-labels {
    position: relative;
    height: 1.1rem;
    margin-top: 0.4rem;
  }

  .fs-demo-track-labels span {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font-size: 0.65rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--at-text-secondary);
    white-space: nowrap;
  }

  .fs-demo-point {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
  }

  .fs-demo-point-dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 2px solid var(--fs-map-line, color-mix(in srgb, var(--at-tertiary) 40%, transparent));
    background: var(--at-bg);
    font-size: 0.85rem;
    color: var(--at-text-secondary);
  }

  .fs-demo-point--hazard .fs-demo-point-dot {
    border-color: var(--fs-danger);
    color: var(--fs-danger);
  }

  .fs-demo-point--finish .fs-demo-point-dot {
    border-color: var(--at-primary);
    color: var(--at-primary);
  }

  .fs-demo-point--checkpoint.fs-demo-point--passed .fs-demo-point-dot {
    border-color: var(--fs-success);
    color: var(--fs-success);
    background: color-mix(in srgb, var(--fs-success) 22%, var(--at-bg));
  }

  .fs-demo-marker {
    position: absolute;
    top: 50%;
    left: 0;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--at-primary);
    transform: translate(-50%, -50%);
    transition-property: left;
    transition-timing-function: var(--fs-ease, ease);
    transition-duration: 300ms;
    z-index: 2;
    box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--at-primary) 25%, transparent);
  }

  .fs-demo-marker--snap {
    transition-duration: 0ms !important;
  }

  .fs-demo-marker--hit {
    background: var(--fs-danger);
    box-shadow: 0 0 0 0.3rem color-mix(in srgb, var(--fs-danger) 40%, transparent);
  }

  .fs-demo-marker--cleared {
    background: var(--fs-success);
    box-shadow: 0 0 0 0.3rem color-mix(in srgb, var(--fs-success) 40%, transparent);
  }

  .fs-demo-marker-label {
    position: absolute;
    top: -1.3rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--at-text-secondary);
    white-space: nowrap;
  }

  .fs-demo-cursor {
    position: absolute;
    top: 50%;
    left: 0;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--at-primary);
    transform: translate(-50%, -50%);
    animation: fs-demo-sweep 1.1s linear infinite alternate;
  }

  fs-live-demo[data-assist="true"] .fs-demo-cursor {
    animation-duration: 2.4s;
  }

  @keyframes fs-demo-sweep {
    from {
      left: 2%;
    }
    to {
      left: 98%;
    }
  }

  .fs-demo-target-zone {
    position: absolute;
    top: 0;
    left: 55%;
    width: 12%;
    height: 100%;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fs-success) 30%, transparent);
    transition: width var(--fs-medium, 320ms) var(--fs-ease, ease);
  }

  fs-live-demo[data-assist="true"] .fs-demo-target-zone {
    width: 32%;
    left: 42%;
  }

  .fs-demo-block-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4rem;
  }

  .fs-demo-block {
    display: inline-block;
    font-size: 2.5rem;
    line-height: 1;
    color: var(--at-primary);
    transition: opacity var(--fs-fast, 120ms) var(--fs-ease, ease);
  }

  .fs-demo-shards {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .fs-demo-shard {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--at-primary);
    transform: translate(-50%, -50%) rotate(var(--fs-shard-angle)) translateX(0);
    opacity: 0;
  }

  .fs-demo-shards--active .fs-demo-shard {
    animation: fs-shard-fly 550ms ease-out forwards;
  }

  @keyframes fs-shard-fly {
    0% {
      opacity: 1;
      transform: translate(-50%, -50%) rotate(var(--fs-shard-angle)) translateX(0);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) rotate(var(--fs-shard-angle)) translateX(2.6rem);
    }
  }

  .fs-demo-impact-flash {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: var(--at-border-radius);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--at-primary) 55%, transparent),
      transparent 70%
    );
    opacity: 0;
    pointer-events: none;
  }

  .fs-demo-impact-flash--active {
    animation: fs-impact-flash 400ms ease-out;
  }

  @keyframes fs-impact-flash {
    0% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
    }
  }

  .fs-demo-impact-pop {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 3;
    margin: 0;
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    color: var(--at-primary);
    opacity: 0;
    transform: translateX(-50%) scale(0.6);
  }

  .fs-demo-impact-pop--active {
    animation: fs-impact-pop 650ms cubic-bezier(0.2, 1.6, 0.4, 1);
  }

  @keyframes fs-impact-pop {
    0% {
      opacity: 0;
      transform: translateX(-50%) scale(0.4) translateY(0.5rem);
    }
    30% {
      opacity: 1;
      transform: translateX(-50%) scale(1.15) translateY(-0.3rem);
    }
    70% {
      opacity: 1;
      transform: translateX(-50%) scale(1) translateY(-0.3rem);
    }
    100% {
      opacity: 0;
      transform: translateX(-50%) scale(1) translateY(-0.6rem);
    }
  }

  .fs-demo-meter {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .fs-demo-meter-label {
    flex: none;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--at-text-secondary);
  }

  .fs-demo-meter-track {
    flex: 1;
    height: 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--at-tertiary) 20%, transparent);
    overflow: hidden;
  }

  .fs-demo-meter-fill {
    height: 100%;
    width: 0%;
    border-radius: 999px;
    background: var(--at-primary);
    transition-property: width;
    transition-timing-function: var(--fs-ease, ease);
    transition-duration: 150ms;
  }

  .fs-demo-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-block: 1rem;
  }

  .fs-demo-controls fieldset {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .fs-demo-controls legend {
    font-weight: 600;
    padding: 0;
  }

  .fs-demo-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .fs-demo-status {
    min-height: 1.4em;
    font-weight: 600;
  }

  .fs-demo-stats {
    color: var(--at-text-secondary);
    font-size: 0.9rem;
  }

  .fs-demo-history {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.5rem;
    min-height: 0.6rem;
  }

  .fs-history-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--fs-spent);
    flex: none;
  }

  .fs-history-dot--hit {
    background: var(--fs-success);
  }

  .fs-history-dot--miss {
    background: var(--fs-danger);
  }

  @media (prefers-reduced-motion: reduce) {
    .fs-demo-cursor {
      animation: none;
      left: 61%;
    }

    .fs-demo-marker {
      transition: none;
    }

    .fs-demo-shards--active .fs-demo-shard,
    .fs-demo-impact-flash--active,
    .fs-demo-impact-pop--active {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  import "../styles/failstate.css";

  class LiveDemo extends HTMLElement {
    attempts = 0;
    successes = 0;
    position = 0;

    connectedCallback() {
      const mode = this.dataset.mode;
      if (mode === "checkpoint") this.setupCheckpoint();
      if (mode === "assist") this.setupAssist();
      if (mode === "juice") this.setupJuice();
    }

    status(text: string) {
      const el = this.querySelector<HTMLElement>('[data-role="status"]');
      if (el) el.textContent = text;
    }

    stats(text: string) {
      const el = this.querySelector<HTMLElement>('[data-role="stats"]');
      if (el) el.textContent = text;
    }

    // A row of dots is a faster read of "am I improving?" than the running
    // count in the stats line alone --- decorative and capped at ten, since
    // the accessible record of what happened stays in that aria-live text.
    pushHistory(kind: "hit" | "miss") {
      const history = this.querySelector<HTMLElement>('[data-role="history"]');
      if (!history) return;
      const dot = document.createElement("span");
      dot.className = `fs-history-dot fs-history-dot--${kind}`;
      history.appendChild(dot);
      while (history.children.length > 10) history.firstElementChild?.remove();
    }

    // A death and a success shouldn't flash the same colour --- "bad" reaches
    // for the danger ring, "good" (unused here today, kept for future modes)
    // for the success one.
    flash(kind: "bad" | "good" = "bad") {
      const stage = this.querySelector<HTMLElement>('[data-role="stage"]');
      if (!stage) return;
      stage.classList.remove("fs-shake", "fs-flash", "fs-flash--danger");
      // Force reflow so the animation can restart on repeated failures.
      void stage.offsetWidth;
      stage.classList.add("fs-shake", kind === "bad" ? "fs-flash--danger" : "fs-flash");
    }

    // Every state change gets its own word in the corner, not just a colour
    // shift --- "Ready" / "Running…" / "Hit!" / "Cleared!" reads on its own,
    // decorative alongside the aria-live status line that carries the same
    // information for anyone not looking at the stage.
    setState(el: HTMLElement | null, label: string, tone: "default" | "danger" = "default") {
      if (!el) return;
      el.textContent = label;
      el.classList.toggle("fs-badge--danger", tone === "danger");
      el.classList.remove("fs-pop");
      void el.offsetWidth;
      el.classList.add("fs-pop");
    }

    setupCheckpoint() {
      const marker = this.querySelector<HTMLElement>('[data-role="marker"]');
      const state = this.querySelector<HTMLElement>('[data-role="state"]');
      const checkpointPoint = this.querySelector<HTMLElement>('[data-role="checkpoint-point"]');
      const button = this.querySelector<HTMLButtonElement>('[data-action="attempt"]');
      const radios = this.querySelectorAll<HTMLInputElement>('input[name^="policy"]');
      // Kept in sync with the Astro-side constants above --- those position
      // the track's points, these drive the simulation.
      const hazardAt = 78;
      const checkpointAt = 45;
      const msPerPercent = 9;
      let deaths = 0;

      const moveTo = (target: number, instant = false) => {
        if (!marker) return 0;
        const distance = Math.abs(target - this.position);
        const duration = instant ? 0 : Math.max(150, distance * msPerPercent);
        marker.classList.toggle("fs-demo-marker--snap", instant);
        marker.style.left = `${target}%`;
        this.position = target;
        return duration;
      };

      const setControlsDisabled = (disabled: boolean) => {
        if (button) button.disabled = disabled;
        radios.forEach((radio) => (radio.disabled = disabled));
      };

      moveTo(0, true);

      radios.forEach((radio) =>
        radio.addEventListener("change", () => {
          marker?.classList.remove("fs-demo-marker--hit", "fs-demo-marker--cleared");
          moveTo(0, true);
          this.setState(state, "Ready");
          this.status("Policy set. Press Attempt the run to start from the top.");
        }),
      );

      button?.addEventListener("click", () => {
        if (!marker || button.disabled) return;
        setControlsDisabled(true);
        marker.classList.remove("fs-demo-marker--hit", "fs-demo-marker--cleared");
        checkpointPoint?.classList.add("fs-demo-point--passed");
        this.setState(state, "Running…");
        this.status("Running toward the hazard…");
        const runMs = moveTo(hazardAt);

        window.setTimeout(() => {
          const died = Math.random() < 0.6;
          this.pushHistory(died ? "miss" : "hit");
          this.attempts += 1;

          if (died) {
            deaths += 1;
            marker.classList.add("fs-demo-marker--hit");
            this.flash("bad");
            this.setState(state, "Hit!", "danger");
            const policy = this.querySelector<HTMLInputElement>(
              'input[name^="policy"]:checked',
            )?.value;
            const respawnAt = policy === "checkpoint" ? checkpointAt : 0;
            this.status(
              policy === "checkpoint"
                ? "Hit the hazard. Generous policy: respawning at the last flag."
                : "Hit the hazard. Punishing policy: respawning at the very start.",
            );
            window.setTimeout(() => {
              const respawnMs = moveTo(respawnAt);
              window.setTimeout(() => {
                marker.classList.remove("fs-demo-marker--hit");
                this.setState(state, "Ready");
                this.status("Ready — press Attempt the run to go again.");
                setControlsDisabled(false);
              }, respawnMs + 100);
            }, 500);
          } else {
            marker.classList.add("fs-demo-marker--cleared");
            this.setState(state, "Cleared!");
            this.status("Cleared the run this time.");
            window.setTimeout(() => {
              const resetMs = moveTo(0);
              window.setTimeout(() => {
                marker.classList.remove("fs-demo-marker--cleared");
                this.setState(state, "Ready");
                this.status("Ready — press Attempt the run to go again.");
                setControlsDisabled(false);
              }, resetMs + 100);
            }, 700);
          }

          this.stats(
            `${this.attempts} attempt${this.attempts === 1 ? "" : "s"} · ${deaths} death${deaths === 1 ? "" : "s"}`,
          );
        }, runMs + 80);
      });
    }

    setupAssist() {
      const toggle = this.querySelector<HTMLInputElement>('[data-role="assist-toggle"]');
      const track = this.querySelector<HTMLElement>('[data-role="track"]');
      const cursor = this.querySelector<HTMLElement>('[data-role="cursor"]');
      const zone = this.querySelector<HTMLElement>('[data-role="zone"]');
      const button = this.querySelector<HTMLButtonElement>('[data-action="jump"]');

      toggle?.addEventListener("change", () => {
        this.toggleAttribute("data-assist", toggle.checked);
        this.dataset.assist = toggle.checked ? "true" : "false";
      });

      button?.addEventListener("click", () => {
        if (!track || !cursor || !zone) return;
        const trackBox = track.getBoundingClientRect();
        const cursorBox = cursor.getBoundingClientRect();
        const zoneBox = zone.getBoundingClientRect();
        const cursorCentre = cursorBox.left + cursorBox.width / 2;
        const hit = cursorCentre >= zoneBox.left && cursorCentre <= zoneBox.right;
        void trackBox;
        this.attempts += 1;
        this.pushHistory(hit ? "hit" : "miss");
        if (hit) {
          this.successes += 1;
          this.status("Clean hit.");
          const stage = this.querySelector<HTMLElement>('[data-role="stage"]');
          stage?.classList.add("fs-pulse");
          window.setTimeout(() => stage?.classList.remove("fs-pulse"), 400);
        } else {
          this.status("Missed — try again.");
          this.flash("bad");
        }
        const rate = Math.round((this.successes / this.attempts) * 100);
        this.stats(`${this.successes}/${this.attempts} hits (${rate}%)`);
      });
    }

    setupJuice() {
      const toggle = this.querySelector<HTMLInputElement>('[data-role="juice-toggle"]');
      const state = this.querySelector<HTMLElement>('[data-role="state"]');
      const block = this.querySelector<HTMLElement>('[data-role="block"]');
      const stage = this.querySelector<HTMLElement>('[data-role="stage"]');
      const shards = this.querySelector<HTMLElement>('[data-role="shards"]');
      const impactFlash = this.querySelector<HTMLElement>('[data-role="impact-flash"]');
      const impactPop = this.querySelector<HTMLElement>('[data-role="impact-pop"]');
      const meterFill = this.querySelector<HTMLElement>('[data-role="meter-fill"]');
      const button = this.querySelector<HTMLButtonElement>('[data-action="break"]');
      let breaks = 0;

      const spawnShards = () => {
        if (!shards) return;
        shards.innerHTML = "";
        for (let i = 0; i < 8; i += 1) {
          const shard = document.createElement("span");
          shard.className = "fs-demo-shard";
          const angle = (360 / 8) * i + (Math.random() * 16 - 8);
          shard.style.setProperty("--fs-shard-angle", `${angle}deg`);
          shards.appendChild(shard);
        }
        shards.classList.remove("fs-demo-shards--active");
        void shards.offsetWidth;
        shards.classList.add("fs-demo-shards--active");
      };

      const setMeter = (pct: number, snap: boolean) => {
        if (!meterFill) return;
        meterFill.style.transitionDuration = snap ? "80ms" : "600ms";
        meterFill.style.width = `${pct}%`;
      };

      button?.addEventListener("click", () => {
        if (!block || button.disabled) return;
        const juiced = toggle?.checked ?? true;
        button.disabled = true;

        const resolve = () => {
          breaks += 1;
          block.style.opacity = "0";

          if (juiced) {
            spawnShards();
            stage?.classList.remove("fs-shake");
            void stage?.offsetWidth;
            stage?.classList.add("fs-shake");
            if (impactFlash) {
              impactFlash.classList.remove("fs-demo-impact-flash--active");
              void impactFlash.offsetWidth;
              impactFlash.classList.add("fs-demo-impact-flash--active");
            }
            if (impactPop) {
              impactPop.textContent = "IMPACT!";
              impactPop.classList.remove("fs-demo-impact-pop--active");
              void impactPop.offsetWidth;
              impactPop.classList.add("fs-demo-impact-pop--active");
            }
            this.setState(state, "Impact!", "danger");
            setMeter(100, true);
            window.setTimeout(() => setMeter(0, false), 450);
            this.status("Impact! Same block, same outcome — only the feedback changed.");
          } else {
            this.setState(state, "Gone.");
            setMeter(4, true);
            window.setTimeout(() => setMeter(0, false), 300);
            this.status("Gone. Identical outcome, nothing announced it.");
          }

          this.stats(`Outcome unaffected by the toggle — block #${breaks} destroyed either way.`);

          window.setTimeout(() => {
            block.style.opacity = "1";
            this.setState(state, "Ready");
            button.disabled = false;
          }, 500);
        };

        if (juiced) {
          // A brief freeze before the burst is what makes it read as an
          // impact rather than a glitch --- the "hit-stop" every juiced hit
          // in a real game leans on.
          window.setTimeout(resolve, 90);
        } else {
          resolve();
        }
      });
    }
  }

  if (!customElements.get("fs-live-demo")) {
    customElements.define("fs-live-demo", LiveDemo);
  }
</script>
