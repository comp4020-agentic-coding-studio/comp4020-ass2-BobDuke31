---
// The sessions listing, reimagined as a roguelike run map instead of a card
// grid --- twelve weeks as nodes on a route rather than rows in a table.
// Built as a real ordered list first (that's what ships with no JS and what
// a screen reader hears); the zig-zag node layout and "cleared" highlighting
// are a CSS/JS enhancement on top of it, per CLAUDE.md's rule that nothing
// here may regress to decoration-only.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { sessionLabels } from "../site-config";

const sessions = await getPublishedCollection("sessions");
const visible = sessions.sort((a, b) => a.data.week - b.data.week);

const typeLabels: Record<string, string> = {
  theory: "Theory",
  "case-study": "Case study",
  capstone: "Capstone",
};

function transitionNameFor(href: string) {
  return `card-title-${href.replace(/^\/|\/$/g, "").replace(/\//g, "-")}`;
}
---

<fs-run-map>
  <ol class="fs-run-map">
    {
      visible.map((session) => {
        const href = withBase(`/sessions/${session.id}/`);
        const type = session.data.tags.find((tag) => tag in typeLabels);
        return (
          <li class="fs-run-node" data-run-slug={session.id}>
            <a href={href} class="fs-run-node-link">
              <span class="fs-run-node-week">Week {session.data.week}</span>
              <h2 class="fs-run-node-title" transition:name={transitionNameFor(href)}>
                {session.data.title}
              </h2>
              {type && <span class="fs-run-node-type" data-type={type}>{typeLabels[type]}</span>}
              {session.data.description && <p>{session.data.description}</p>}
              <span class="fs-run-node-status" aria-hidden="true">Cleared</span>
            </a>
          </li>
        );
      })
    }
  </ol>
  <p class="fs-run-map-hint">
    Every week of {sessionLabels.plural.toLowerCase()} the way a run through the
    course looks from the outside. Nodes you have opened stay marked as
    cleared.
  </p>
</fs-run-map>

<style>
  .fs-run-map {
    --fs-map-line: color-mix(in srgb, var(--at-tertiary) 40%, transparent);
    list-style: none;
    margin: 2rem 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    position: relative;
  }

  .fs-run-map::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: 1.4rem;
    width: 2px;
    background: var(--fs-map-line);
  }

  @media (min-width: 48rem) {
    .fs-run-map::before {
      inset-inline-start: 50%;
    }

    .fs-run-node:nth-child(odd) {
      justify-self: start;
      padding-inline-end: calc(50% + 1.5rem);
    }

    .fs-run-node:nth-child(even) {
      justify-self: end;
      padding-inline-start: calc(50% + 1.5rem);
    }
  }

  .fs-run-node-link {
    display: block;
    position: relative;
    padding: 1rem 1.25rem;
    border: 1px solid var(--fs-map-line);
    border-radius: 0.75rem;
    color: inherit;
    text-decoration: none;
    background: var(--at-bg-alt);
    transition: transform var(--fs-fast, 120ms) var(--fs-ease, ease), border-color var(--fs-fast, 120ms);
  }

  .fs-run-node-link:hover,
  .fs-run-node-link:focus-visible {
    transform: translateY(-2px);
    border-color: var(--at-primary);
  }

  .fs-run-node-week {
    display: block;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--at-text-secondary);
  }

  .fs-run-node-title {
    margin: 0.15rem 0 0.4rem;
  }

  .fs-run-node-type {
    display: inline-block;
    margin-bottom: 0.4rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    font-size: 0.75rem;
    background: color-mix(in srgb, var(--at-primary) 15%, transparent);
    color: var(--at-primary);
  }

  .fs-run-node-type[data-type="capstone"] {
    background: color-mix(in srgb, var(--fs-danger) 18%, transparent);
    color: var(--fs-danger);
  }

  .fs-run-node-status {
    position: absolute;
    top: 0.75rem;
    inset-inline-end: 0.9rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fs-success);
    opacity: 0;
  }

  .fs-run-node.fs-run-node--visited .fs-run-node-status {
    opacity: 1;
  }

  .fs-run-node.fs-run-node--visited .fs-run-node-link {
    border-color: var(--fs-success);
  }

  .fs-run-map-hint {
    color: var(--at-text-secondary);
    font-size: 0.9rem;
  }
</style>

<script>
  import { getVisitedRuns, RUN_STATE_EVENT } from "../scripts/run-state";

  class RunMap extends HTMLElement {
    connectedCallback() {
      this.paint();
      window.addEventListener(RUN_STATE_EVENT, () => this.paint());
    }

    paint() {
      const visited = getVisitedRuns();
      this.querySelectorAll<HTMLElement>(".fs-run-node").forEach((node) => {
        const slug = node.dataset.runSlug;
        node.classList.toggle("fs-run-node--visited", !!slug && visited.has(slug));
      });
    }
  }

  if (!customElements.get("fs-run-map")) {
    customElements.define("fs-run-map", RunMap);
  }
</script>
