---
// A small thematic hero decoration: a strip of "lives," some spent. Purely
// declarative --- unlike LiveDemo, nothing here is interactive --- but it
// sets the visual register (arcade HUD, not lecture-theatre photography)
// before a single word of the homepage copy loads.
export interface Props {
  lives: number;
  spent: number;
}

const { lives, spent } = Astro.props;
const items = Array.from({ length: lives }, (_, i) => i < lives - spent);
---

<p class="fs-lives" aria-label={`${lives - spent} of ${lives} lives remaining`}>
  {
    items.map((alive) => (
      <svg
        class:list={["fs-life", { "fs-life--spent": !alive, "fs-pulse": alive }]}
        viewBox="0 0 24 22"
        width="28"
        height="26"
        aria-hidden="true"
      >
        <path d="M12 20 C4 14 1 9.5 1 6.2 1 3 3.3 1 6 1c1.9 0 3.7 1.1 4.6 2.8C11.5 2.1 13.3 1 15.2 1 17.9 1 20 3 20 6.2 20 9.5 17 14 9 20 Z" />
      </svg>
    ))
  }
  <span class="fs-lives-label">{lives - spent} of {lives} lives left this run</span>
</p>

<style>
  .fs-lives {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-block: 0 1.5rem;
  }

  .fs-life {
    fill: var(--fs-success);
    stroke: var(--fs-success);
    flex: none;
  }

  .fs-life--spent {
    fill: none;
    stroke: var(--fs-spent);
    stroke-dasharray: 2 3;
  }

  .fs-lives-label {
    margin-inline-start: 0.5rem;
    color: var(--at-text-secondary);
    font-size: 0.95rem;
  }
</style>
