---
import { getEntries, type CollectionEntry } from "astro:content";
import { withBase } from "astro-theme-university/url";

interface Props {
  teachers: CollectionEntry<"sessions">["data"]["teachers"] | CollectionEntry<"lectures">["data"]["teachers"];
}

const { teachers } = Astro.props;
// A session or lecture with no `teachers:` renders no team at all.
const people = teachers ? await getEntries(teachers) : [];
---

{
  people.length > 0 && (
    <section aria-labelledby="teaching-team">
      <h2 id="teaching-team">Teaching team</h2>
      <ul class="fs-teaching-team">
        {people.map((person) => (
          <li>
            <a href={withBase(`/people/${person.id}/`)}>{person.data.title}</a>
            <span class="fs-badge fs-badge--neutral">{person.data.role}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .fs-teaching-team {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fs-teaching-team li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
